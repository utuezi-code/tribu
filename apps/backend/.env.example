# Base de données (Supabase Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/tribu?schema=public"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"

# Auth OTP
# "mock" : le code OTP est loggé côté serveur (dev/test), aucune vraie carte SIM requise.
# "vonage" : envoi réel via l'API Vonage.
SMS_PROVIDER="mock"
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_BRAND_NAME="Tribu"

# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="event-media"

# Jobs (BullMQ)
REDIS_URL="redis://localhost:6379"

# Notifications push (Expo)
EXPO_ACCESS_TOKEN=""

# Monitoring
SENTRY_DSN=""

PORT=3000
