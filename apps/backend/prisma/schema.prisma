generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String            @id @default(uuid())
  phoneNumber String            @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime          @default(now())
  events      EventMembership[]
  messages    Message[]
  media       Media[]
  pushTokens  PushToken[]
}

model Event {
  id            String            @id @default(uuid())
  name          String
  type          EventType
  coverImageUrl String?
  startDate     DateTime
  endDate       DateTime
  timezone      String            @default("Europe/Paris")
  status        EventStatus       @default(ACTIVE)
  archivedAt    DateTime?
  createdBy     String
  inviteCode    String            @unique @default(cuid())
  createdAt     DateTime          @default(now())
  members       EventMembership[]
  messages      Message[]
  media         Media[]
  archiveLogs   ArchiveJobLog[]
}

enum EventType {
  VOYAGE
  MARIAGE
  ANNIVERSAIRE
  SOIREE
  AUTRE
}

enum EventStatus {
  ACTIVE
  GRACE_PERIOD
  ARCHIVED
}

model EventMembership {
  id       String     @id @default(uuid())
  userId   String
  eventId  String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  user     User       @relation(fields: [userId], references: [id])
  event    Event      @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

enum MemberRole {
  ORGANIZER
  MEMBER
}

model Message {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  content   String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  media     Media[]
}

model Media {
  id           String    @id @default(uuid())
  eventId      String
  userId       String
  messageId    String?
  storageUrl   String
  thumbnailUrl String?
  type         MediaType
  createdAt    DateTime  @default(now())
  event        Event     @relation(fields: [eventId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  message      Message?  @relation(fields: [messageId], references: [id])
}

enum MediaType {
  PHOTO
  VIDEO
}

model ArchiveJobLog {
  id         String   @id @default(uuid())
  eventId    String
  status     String
  executedAt DateTime @default(now())
  errorMsg   String?
  event      Event    @relation(fields: [eventId], references: [id])
}

model OtpCode {
  id          String   @id @default(uuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
